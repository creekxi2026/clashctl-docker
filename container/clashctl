#!/usr/bin/env bash
umask 077
# NAS terminals may report zero rows/columns; preserve valid sizes and piped calls.
_fix_terminal_size() {
    [ -t 0 ] || return 0
    local size rows cols
    size=$(stty size 2>/dev/null) || return 0
    read -r rows cols <<< "$size"
    [[ "$rows" =~ ^[0-9]+$ && "$cols" =~ ^[0-9]+$ ]] || return 0
    [ "$rows" = 0 ] || [ "$cols" = 0 ] || return 0
    [ "$rows" != 0 ] || rows=30
    [ "$cols" != 0 ] || cols=120
    stty rows "$rows" cols "$cols" 2>/dev/null || :
}
_fix_terminal_size
unset -f _fix_terminal_size
export CLASHCTL_HOME=/opt/clashctl
source "$CLASHCTL_HOME/scripts/cmd/clashctl.sh"
# Keep an alias of upstream conversion before wrapping its working directory/lock.
eval "$(declare -f _download_convert_config | sed '1s/_download_convert_config/_download_convert_config_upstream/')"
_download_convert_config() { (flock -w 60 8 || exit 1; _container_convert "$@") 8>/data/converter.lock; }
case "${1:-help}" in
    on) service_is_active || service_start ;;
    off) service_stop ;;
    status) service_status ;;
    upgrade|tun|ui|secret)
        printf '%s
' 'This container supports sub/node/on/off/status/log/mixin. Upgrade by pulling a new image; TUN is not included. Enable the bundled dashboard with compose.ui.yaml; its secret is stored in /data/controller.secret.' >&2
        exit 2 ;;
    *) clashctl "$@" ;;
esac
