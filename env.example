# Copy to .env beside compose.yaml. Never commit the real subscription URL.
SUB_URL=
SUB_UPDATE_INTERVAL=86400
# Choose a strong secret before enabling the UI; blank keeps the stored/generated key.
UI_SECRET=
BIND_IP=127.0.0.1
PROXY_PORT=7890
# Used only with compose.ui.yaml; use a private NAS IP for LAN browser access.
UI_BIND_IP=127.0.0.1
UI_PORT=9090
